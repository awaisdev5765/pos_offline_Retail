<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="com.airtechsolutions.offline_pos_system"
    Publisher="CN=AirTech Solutions"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Retail POS</DisplayName>
    <PublisherDisplayName>AirTech Solutions</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
    <uap:Capability Name="documentsLibrary" />
    <uap:Capability Name="picturesLibrary" />
    <uap:Capability Name="videosLibrary" />
    <uap:Capability Name="musicLibrary" />
    <uap:Capability Name="removableStorage" />
  </Capabilities>

  <Applications>
    <Application Id="App"
      Executable="RetailPOS.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Retail POS"
        Description="A fully offline Point-of-Sale system with Khata (credit) management"
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- File Association -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="posfile">
            <uap:SupportedFileTypes>
              <uap:FileType>.pos</uap:FileType>
              <uap:FileType>.posbackup</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>

        <!-- Protocol Association -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="possystem">
            <uap:DisplayName>POS System Protocol</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- Share Contract -->
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget Description="Share with POS System">
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType />
            </uap:SupportedFileTypes>
            <uap:DataFormat>Text</uap:DataFormat>
            <uap:DataFormat>Uri</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>

        <!-- Auto-play -->
        <uap3:Extension Category="windows.autoPlayContent">
          <uap3:AutoPlayContent>
            <uap3:LaunchAction
              Verb="open"
              ActionDisplayName="Open with POS System"
              ContentEventVerb="Play">
              <uap3:InvokeAction File="RetailPOS.exe" />
            </uap3:LaunchAction>
          </uap3:AutoPlayContent>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
